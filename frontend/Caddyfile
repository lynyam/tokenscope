{
	admin off
	auto_https disable_redirects
}

localhost {
	tls internal

	handle /api/* {
		# 10 MiB file plus multipart overhead.
		request_body {
			max_size 11MiB
		}
		reverse_proxy backend:{$BACKEND_PORT:3000} {
			header_up X-Forwarded-For {http.request.remote.host}
			header_up -Forwarded
			header_up -X-Real-IP
		}
	}

    @realtime path /socket.io /socket.io/*
    handle @realtime {
        reverse_proxy backend:{$BACKEND_PORT:3000} {
            header_up X-Forwarded-For {http.request.remote.host}
            header_up -Forwarded
            header_up -X-Real-IP
        }
    }

	# Only frontend routes receive compression and the SPA fallback.
	# API ETags must remain unchanged for If-Match.
	handle {
		encode gzip
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
