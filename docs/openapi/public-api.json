                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Traces"
        ],
        "operationId": "deleteTrace",
        "summary": "Soft-delete a trace using the current version",
        "description": "Retains the row and externalId. Later GET/DELETE returns 404. POST with the same identity returns TRACE_DELETED. No request body is required.",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "Exactly one quoted positive version, such as \"1\". Weak tags, lists and wildcard are rejected.",
