              "type": "string",
              "pattern": "^\"[1-9][0-9]*\"$",
              "examples": [
                "\"1\""
              ]
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted; no response body.",
            "headers": {
              "X-Request-Id": {
                "description": "Request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR or MODEL_PRICE_NOT_FOUND.",
            "headers": {
              "X-Request-Id": {
                "description": "Request correlation identifier.",
