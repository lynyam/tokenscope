# PostgreSQL
POSTGRES_USER=tokenscope
POSTGRES_PASSWORD=tokenscope_dev_password
POSTGRES_DB=tokenscope
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Application ports
FRONTEND_PORT=5173
BACKEND_PORT=3000

# Authentication
# Generate a secret locally and set it in untracked .env file.
# from the repo root, generate a secret using Node inside your running backend container.
# command: docker compose exec -T backend node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
JWT_SECRET=
JWT_ISSUER=tokenscope
JWT_AUDIENCE=tokenscope-web
JWT_ACCESS_TTL_SECONDS=3600
