{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/database/.*\\.integration\\.spec\\.ts$",
  "setupFiles": [
    "<rootDir>/test/support/require-test-database.ts"
  ],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.test.json"
      }
    ]
  }
}
