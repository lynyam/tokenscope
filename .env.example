# PostgreSQL
POSTGRES_USER=tokenscope
POSTGRES_PASSWORD=tokenscope_dev_password
POSTGRES_DB=tokenscope
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Application ports
FRONTEND_PORT=5173
BACKEND_PORT=3000

# Authentication
# Evaluation startup generates JWT_SECRET only when missing or empty.
# For manual development setup, generate it without a running backend:
# docker run --rm node:24-alpine node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
# Copy the result into your untracked .env. Never commit the generated value.
JWT_SECRET=
JWT_ISSUER=tokenscope
JWT_AUDIENCE=tokenscope-web
JWT_ACCESS_TTL_SECONDS=3600
DOCUMENT_STORAGE_ROOT=/var/lib/tokenscope/documents
# Optional for a backend started outside Compose.
# Compose explicitly trusts its frontend service.
# Leave empty when calling the backend directly.
TRUSTED_PROXY_HOST=

# Evaluation mode: make eval-up
# serves https://localhost:8443
# Port busy? EVAL_HTTPS_PORT=9443 make eval-up

# Assistant (TSE-80), backend only. Never use a VITE_ variable for the key.
# Empty key: the app still starts, assistant requests return 503 LLM_UNAVAILABLE.
# Put the real key only in your untracked .env.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Exact browser origins, no trailing slash. Adapt when changing frontend ports.
REALTIME_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:8443

# Optional evaluation accounts. Supply your own 8–128 character password.
# Keep this value in the ignored .env, never in Make arguments or Git.
DEMO_PASSWORD=
# Direct npm seed invocations require this opt-in. The explicit Make seed
# command enables it only for its child process, not for normal application startup.
EVALUATION_SEED_ENABLED=false
