# PostgreSQL
POSTGRES_USER=tokenscope
POSTGRES_PASSWORD=tokenscope_dev_password
POSTGRES_DB=tokenscope
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Application ports
FRONTEND_PORT=5173
BACKEND_PORT=3000

# Authentication
# Evaluation startup generates JWT_SECRET only when missing or empty.
# For manual development setup, generate it without a running backend:
# docker run --rm node:24-alpine node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
# Copy the result into your untracked .env. Never commit the generated value.
JWT_SECRET=
JWT_ISSUER=tokenscope
JWT_AUDIENCE=tokenscope-web
JWT_ACCESS_TTL_SECONDS=3600

# Evaluation mode: make eval-up
# serves https://localhost:8443
# Port busy? EVAL_HTTPS_PORT=9443 make eval-up
